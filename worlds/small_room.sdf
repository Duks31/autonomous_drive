<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="small_room">

    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands"/>

    <!-- Scene lighting -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.3 0.3 0.3 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Main overhead light -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
    </light>

    <!-- Secondary fill light -->
    <light type="point" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 2.5 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.5</constant>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- ==================== GROUND ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== WALLS ==================== -->

    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 1.55 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.1 0.1 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.1 0.1 1.2</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.80 1</ambient>
            <diffuse>0.85 0.85 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -1.55 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.1 0.1 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.1 0.1 1.2</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.80 1</ambient>
            <diffuse>0.85 0.85 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>1.55 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 3.1 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 3.1 1.2</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.80 1</ambient>
            <diffuse>0.85 0.85 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-1.55 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 3.1 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 3.1 1.2</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.80 1</ambient>
            <diffuse>0.85 0.85 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== TABLE ==================== -->
    <!-- Tabletop -->
    <model name="table_top">
      <static>true</static>
      <pose>0.7 -0.7 0.48 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.4 0.04</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.04</size></box></geometry>
          <material>
            <ambient>0.45 0.28 0.10 1</ambient>
            <diffuse>0.45 0.28 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table leg FL -->
    <model name="table_leg_fl">
      <static>true</static>
      <pose>0.97 -0.53 0.24 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.48</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.48</size></box></geometry>
          <material>
            <ambient>0.35 0.20 0.08 1</ambient>
            <diffuse>0.35 0.20 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table leg FR -->
    <model name="table_leg_fr">
      <static>true</static>
      <pose>0.43 -0.53 0.24 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.48</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.48</size></box></geometry>
          <material>
            <ambient>0.35 0.20 0.08 1</ambient>
            <diffuse>0.35 0.20 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table leg BL -->
    <model name="table_leg_bl">
      <static>true</static>
      <pose>0.97 -0.87 0.24 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.48</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.48</size></box></geometry>
          <material>
            <ambient>0.35 0.20 0.08 1</ambient>
            <diffuse>0.35 0.20 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table leg BR -->
    <model name="table_leg_br">
      <static>true</static>
      <pose>0.43 -0.87 0.24 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.48</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.48</size></box></geometry>
          <material>
            <ambient>0.35 0.20 0.08 1</ambient>
            <diffuse>0.35 0.20 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== CRATES ==================== -->

    <!-- Crate 1 - NW area -->
    <model name="crate_1">
      <static>true</static>
      <pose>-0.9 0.9 0.2 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.35 0.35 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.35 0.35 0.4</size></box></geometry>
          <material>
            <ambient>0.55 0.38 0.18 1</ambient>
            <diffuse>0.55 0.38 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Crate 2 - stacked on crate 1 (smaller) -->
    <model name="crate_2">
      <static>true</static>
      <pose>-0.9 0.9 0.55 0 0 0.8</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.25 0.25 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 0.25 0.3</size></box></geometry>
          <material>
            <ambient>0.50 0.32 0.14 1</ambient>
            <diffuse>0.50 0.32 0.14 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Crate 3 - SE area -->
    <model name="crate_3">
      <static>true</static>
      <pose>0.9 -0.3 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.4</size></box></geometry>
          <material>
            <ambient>0.55 0.38 0.18 1</ambient>
            <diffuse>0.55 0.38 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== TRAFFIC CONES ==================== -->

    <!-- Cone 1 base -->
    <model name="cone_1_base">
      <static>true</static>
      <pose>0.0 0.7 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.18 0.18 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.18 0.18 0.1</size></box></geometry>
          <material>
            <ambient>0.9 0.4 0.0 1</ambient>
            <diffuse>0.9 0.4 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cone 1 body -->
    <model name="cone_1_body">
      <static>true</static>
      <pose>0.0 0.7 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.10 0.10 0.30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 0.10 0.30</size></box></geometry>
          <material>
            <ambient>0.9 0.2 0.0 1</ambient>
            <diffuse>0.9 0.2 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cone 2 base -->
    <model name="cone_2_base">
      <static>true</static>
      <pose>-0.5 0.0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.18 0.18 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.18 0.18 0.1</size></box></geometry>
          <material>
            <ambient>0.9 0.4 0.0 1</ambient>
            <diffuse>0.9 0.4 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cone 2 body -->
    <model name="cone_2_body">
      <static>true</static>
      <pose>-0.5 0.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.10 0.10 0.30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 0.10 0.30</size></box></geometry>
          <material>
            <ambient>0.9 0.2 0.0 1</ambient>
            <diffuse>0.9 0.2 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cone 3 base -->
    <model name="cone_3_base">
      <static>true</static>
      <pose>0.4 0.3 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.18 0.18 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.18 0.18 0.1</size></box></geometry>
          <material>
            <ambient>0.9 0.4 0.0 1</ambient>
            <diffuse>0.9 0.4 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Cone 3 body -->
    <model name="cone_3_body">
      <static>true</static>
      <pose>0.4 0.3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.10 0.10 0.30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 0.10 0.30</size></box></geometry>
          <material>
            <ambient>0.9 0.2 0.0 1</ambient>
            <diffuse>0.9 0.2 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== SHORT DIVIDER WALL ==================== -->
    <model name="divider">
      <static>true</static>
      <pose>-0.2 -0.4 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.08 0.7 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.7 0.7</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== BARREL (cylinder approximated) ==================== -->
    <!-- Barrel body -->
    <model name="barrel">
      <static>true</static>
      <pose>-0.8 -0.3 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.25 0.25 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.125</radius><length>0.6</length></cylinder></geometry>
          <material>
            <ambient>0.2 0.3 0.6 1</ambient>
            <diffuse>0.2 0.3 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== SMALL BOXES (scattered) ==================== -->

    <!-- Small box 1 on table -->
    <model name="box_on_table">
      <static>true</static>
      <pose>0.65 -0.65 0.57 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 0.15 0.15</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 0.15 0.15</size></box></geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Small box 2 floor -->
    <model name="small_box_floor">
      <static>true</static>
      <pose>0.2 -1.1 0.1 0 0 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
          <material>
            <ambient>0.7 0.2 0.2 1</ambient>
            <diffuse>0.7 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>